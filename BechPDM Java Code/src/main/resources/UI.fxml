<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.collections.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<ScrollPane xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="graphics.codes.UI">

    <VBox spacing="10">

        <padding>
            <Insets bottom="10" left="10" right="10" top="10" />
        </padding>

        <GridPane>
            <Text style="-fx-font-weight: bolder" text="1.Supported Patterns:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
         <columnConstraints>
            <ColumnConstraints />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints />
         </rowConstraints>
        </GridPane>

        <GridPane hgap="10" style="-fx-border-color: black" vgap="20">

            <padding>
                <Insets bottom="10" left="10" right="10" top="10" />
            </padding>

            <Text text="Load Balancing:" GridPane.columnIndex="0" GridPane.rowIndex="0" />

            <TextField fx:id="consolidationTxt" text="0" GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <Text text="Sidecar:" GridPane.columnIndex="2" GridPane.rowIndex="0" />

            <TextField fx:id="sidecarTxt" text="0" GridPane.columnIndex="3" GridPane.rowIndex="0" />

            <Text text="Priority Queue:" GridPane.columnIndex="4" GridPane.rowIndex="0" />

            <TextField fx:id="priorityqTxt" text="0" GridPane.columnIndex="5" GridPane.rowIndex="0" />

            <Text text="Cache-Aside:" GridPane.columnIndex="6" GridPane.rowIndex="0" />

            <TextField fx:id="cahceasideTxt" text="0" GridPane.columnIndex="7" GridPane.rowIndex="0" />

            <Text text="Aggregator:" GridPane.columnIndex="8" GridPane.rowIndex="0" />

            <TextField fx:id="aggregatorTxt" text="0" GridPane.columnIndex="9" GridPane.rowIndex="0" />

            <Text text="Leader Election:" GridPane.columnIndex="0" GridPane.rowIndex="1" />

            <TextField fx:id="leaderElectionTxt" text="0" GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <Text text="Pipes and Filters:" GridPane.columnIndex="2" GridPane.rowIndex="1" />

            <TextField fx:id="pipesAndFiltersTxt" text="0" GridPane.columnIndex="3" GridPane.rowIndex="1" />

            <Text text="Api Gateway" GridPane.columnIndex="4" GridPane.rowIndex="1" />

            <TextField fx:id="apiGatewayTxt" text="0" GridPane.columnIndex="5" GridPane.rowIndex="1" />

            <Text text="Event Sourcing:" GridPane.columnIndex="6" GridPane.rowIndex="1" />

            <TextField fx:id="eventSourcingTxt" text="0" GridPane.columnIndex="7" GridPane.rowIndex="1" />

            <Text text="Saga:" GridPane.columnIndex="8" GridPane.rowIndex="1" />

            <TextField fx:id="sagaTxt" text="0" GridPane.columnIndex="9" GridPane.rowIndex="1" />

            <Text text="Service per Container" GridPane.columnIndex="0" GridPane.rowIndex="2" />

            <TextField fx:id="staticContentHostTxt" text="0" GridPane.columnIndex="1" GridPane.rowIndex="2" />

            <Text text="Ambassador:" GridPane.columnIndex="2" GridPane.rowIndex="2" />

            <TextField fx:id="ambassadorTxt" text="0" GridPane.columnIndex="3" GridPane.rowIndex="2" />

            <Text text="Service Discovery:" GridPane.columnIndex="4" GridPane.rowIndex="2" />

            <TextField fx:id="serviceDiscoveryTxt" text="0" GridPane.columnIndex="5" GridPane.rowIndex="2" />
         <columnConstraints>
            <ColumnConstraints />
            <ColumnConstraints />
            <ColumnConstraints />
            <ColumnConstraints />
            <ColumnConstraints />
            <ColumnConstraints />
            <ColumnConstraints />
            <ColumnConstraints />
            <ColumnConstraints />
            <ColumnConstraints />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
         </rowConstraints>

        </GridPane>

        <GridPane>
            <Text style="-fx-font-weight: bolder" text="2.Microservice Entry:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
         <columnConstraints>
            <ColumnConstraints />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints />
         </rowConstraints>
        </GridPane>

        <TableView fx:id="tableView" onMouseClicked="#tableViewLogic">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <columns>
                <TableColumn text="Microservice Name">
                    <cellValueFactory>
                        <PropertyValueFactory property="microserviceName" />
                    </cellValueFactory>
                </TableColumn>
                <TableColumn text="URI">
                    <cellValueFactory>
                        <PropertyValueFactory property="uRI">

                        </PropertyValueFactory>
                    </cellValueFactory>
                </TableColumn>
                <TableColumn text="Role">
                    <cellValueFactory>
                        <PropertyValueFactory property="role">

                        </PropertyValueFactory>
                    </cellValueFactory>
                </TableColumn>
                <TableColumn text="Pattern Name">
                    <cellValueFactory>
                        <PropertyValueFactory property="patternName">

                        </PropertyValueFactory>
                    </cellValueFactory>
                </TableColumn>
                <TableColumn text="Implemented Connection Type">
                    <cellValueFactory>
                        <PropertyValueFactory property="implementedConnectionType" />
                    </cellValueFactory>
                </TableColumn>


                <TableColumn text="Connected To">
                    <cellValueFactory>
                        <PropertyValueFactory property="connectedTo" />
                    </cellValueFactory>
                </TableColumn>
            </columns>
        </TableView>

        <GridPane fx:id="pane" hgap="10" vgap="10">

            <Text text="Microservice Name:" GridPane.columnIndex="0" GridPane.rowIndex="0" />

            <TextField fx:id="microserviceTxt" GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <Text text="URI:" GridPane.columnIndex="0" GridPane.rowIndex="1" />

            <TextField fx:id="uriTxt" GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <Text text="Role:" GridPane.columnIndex="0" GridPane.rowIndex="2" />

            <TextField fx:id="roleTxt" GridPane.columnIndex="1" GridPane.rowIndex="2" />

            <Text text="Pattern Name:" GridPane.columnIndex="0" GridPane.rowIndex="3" />

            <TextField fx:id="patternNameTxt" GridPane.columnIndex="1" GridPane.rowIndex="3" />

            <Text text="Implemented Connection Type:" GridPane.columnIndex="0" GridPane.rowIndex="4" />

            <ScrollPane prefHeight="50" GridPane.columnIndex="1" GridPane.rowIndex="4">

                <VBox fx:id="connectionTypeVBox">

                    <ChoiceBox fx:id="connectionTypeCB" onMouseClicked="#connectionTypeAdd">

                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="POST" />
                                <String fx:value="PUT" />
                                <String fx:value="DELETE" />
                                <String fx:value="GET" />
                            </FXCollections>
                        </items>

                    </ChoiceBox>

                </VBox>

            </ScrollPane>

            <Text text="Connected To:" GridPane.columnIndex="0" GridPane.rowIndex="5" />

            <ScrollPane prefHeight="50" GridPane.columnIndex="1" GridPane.rowIndex="5">
                <HBox>
                    <VBox fx:id="textfieldVBox">
                        <TextField fx:id="textField" onKeyReleased="#connectedToAdd" />
                    </VBox>
                    <VBox fx:id="choiceBoxVBox">
                        <ChoiceBox>
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="POST" />
                                    <String fx:value="PUT" />
                                    <String fx:value="DELETE" />
                                    <String fx:value="GET" />
                                </FXCollections>
                            </items>
                            <value>
                                <String fx:value="POST" />
                            </value>
                        </ChoiceBox>
                    </VBox>
                </HBox>
            </ScrollPane>

            <Button fx:id="saveToBtn" onAction="#saveToBtnLogic" text="Click to Set Target Directory for Contents Generated" GridPane.columnIndex="3" GridPane.rowIndex="0" />

            <Text fx:id="pathTxt" text="Your Project will be Saved on: " GridPane.columnIndex="4" GridPane.rowIndex="0" />

            <Button fx:id="submitBtn" alignment="CENTER" onAction="#submitBtn" text="Click to Insert Entries to Table" GridPane.columnIndex="3" GridPane.rowIndex="5" />

            <Button fx:id="doneBtn" onAction="#doneBtnLogic" text="Generate" GridPane.columnIndex="3" GridPane.rowIndex="1" />

            <Text fx:id="errorTxt" GridPane.columnIndex="2" GridPane.rowIndex="4" />
         <columnConstraints>
            <ColumnConstraints />
            <ColumnConstraints />
            <ColumnConstraints />
            <ColumnConstraints />
            <ColumnConstraints />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
         </rowConstraints>

        </GridPane>

    </VBox>

</ScrollPane>
