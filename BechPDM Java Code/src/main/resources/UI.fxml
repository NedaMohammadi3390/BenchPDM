<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.text.Text?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<?import javafx.geometry.Insets?>

<ScrollPane
        xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="graphics.codes.UI"
>

    <VBox spacing="10">

        <padding>
            <Insets top="10" right="10" bottom="10" left="10"/>
        </padding>

        <GridPane>
            <Text
                    text="1.Supported Patterns:"
                    GridPane.rowIndex="0"
                    GridPane.columnIndex="0"
                    style="-fx-font-weight: bolder"
            />
        </GridPane>

        <GridPane  vgap="20" hgap="10" style="-fx-border-color: black">

            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <Text
                    text="Load Balancing:"
                    GridPane.rowIndex="0"
                    GridPane.columnIndex="0"
            />

            <TextField
                    fx:id="consolidationTxt"
                    text="0"
                    GridPane.rowIndex="0"
                    GridPane.columnIndex="1"
            />

            <Text
                    text="Sidecar:"
                    GridPane.rowIndex="0"
                    GridPane.columnIndex="2"
            />

            <TextField
                    fx:id="sidecarTxt"
                    text="0"
                    GridPane.rowIndex="0"
                    GridPane.columnIndex="3"
            />

            <Text
                    text="Priority Queue:"
                    GridPane.rowIndex="0"
                    GridPane.columnIndex="4"
            />

            <TextField
                    fx:id="priorityqTxt"
                    text="0"
                    GridPane.rowIndex="0"
                    GridPane.columnIndex="5"
            />

            <Text
                    text="Cache-Aside:"
                    GridPane.rowIndex="0"
                    GridPane.columnIndex="6"
            />

            <TextField
                    fx:id="cahceasideTxt"
                    text="0"
                    GridPane.rowIndex="0"
                    GridPane.columnIndex="7"
            />

            <Text
                    text="Aggregator:"
                    GridPane.rowIndex="0"
                    GridPane.columnIndex="8"
            />

            <TextField
                    fx:id="aggregatorTxt"
                    text="0"
                    GridPane.rowIndex="0"
                    GridPane.columnIndex="9"
            />

            <Text
                    text="Leader Election:"
                    GridPane.rowIndex="1"
                    GridPane.columnIndex="0"
            />

            <TextField
                    fx:id="leaderElectionTxt"
                    text="0"
                    GridPane.rowIndex="1"
                    GridPane.columnIndex="1"
            />

            <Text
                    text="Pipes and Filters:"
                    GridPane.rowIndex="1"
                    GridPane.columnIndex="2"
            />

            <TextField
                    fx:id="pipesAndFiltersTxt"
                    text="0"
                    GridPane.rowIndex="1"
                    GridPane.columnIndex="3"
            />

            <Text
                    text="Api Gateway"
                    GridPane.rowIndex="1"
                    GridPane.columnIndex="4"
            />

            <TextField
                    fx:id="apiGatewayTxt"
                    text="0"
                    GridPane.rowIndex="1"
                    GridPane.columnIndex="5"
            />

            <Text
                    text="Event Sourcing:"
                    GridPane.rowIndex="1"
                    GridPane.columnIndex="6"
            />

            <TextField
                    fx:id="eventSourcingTxt"
                    text="0"
                    GridPane.rowIndex="1"
                    GridPane.columnIndex="7"
            />

            <Text
                    text="Saga:"
                    GridPane.rowIndex="1"
                    GridPane.columnIndex="8"
            />

            <TextField
                    fx:id="sagaTxt"
                    text="0"
                    GridPane.rowIndex="1"
                    GridPane.columnIndex="9"
            />

            <Text
                    text="Content per Host:"
                    GridPane.rowIndex="2"
                    GridPane.columnIndex="0"
            />

            <TextField
                    fx:id="staticContentHostTxt"
                    text="0"
                    GridPane.rowIndex="2"
                    GridPane.columnIndex="1"
            />

            <Text
                    text="Ambassador:"
                    GridPane.rowIndex="2"
                    GridPane.columnIndex="2"
            />

            <TextField
                    fx:id="ambassadorTxt"
                    text="0"
                    GridPane.rowIndex="2"
                    GridPane.columnIndex="3"
            />

            <Text
                    text="Service Discovery:"
                    GridPane.rowIndex="2"
                    GridPane.columnIndex="4"
            />

            <TextField
                    fx:id="serviceDiscoveryTxt"
                    text="0"
                    GridPane.rowIndex="2"
                    GridPane.columnIndex="5"
            />

        </GridPane>

        <GridPane>
            <Text
                    text="2.Microservice Entry:"
                    GridPane.rowIndex="0"
                    GridPane.columnIndex="0"
                    style="-fx-font-weight: bolder"
            />
        </GridPane>

        <TableView fx:id="tableView"
                   onMouseClicked="#tableViewLogic">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <columns>
                <TableColumn text="Microservice Name">
                    <cellValueFactory>
                        <PropertyValueFactory property="microserviceName"/>
                    </cellValueFactory>
                </TableColumn>
                <TableColumn text="URI">
                    <cellValueFactory>
                        <PropertyValueFactory property="uRI">

                        </PropertyValueFactory>
                    </cellValueFactory>
                </TableColumn>
                <TableColumn text="Role">
                    <cellValueFactory>
                        <PropertyValueFactory property="role">

                        </PropertyValueFactory>
                    </cellValueFactory>
                </TableColumn>
                <TableColumn text="Pattern Name">
                    <cellValueFactory>
                        <PropertyValueFactory property="patternName">

                        </PropertyValueFactory>
                    </cellValueFactory>
                </TableColumn>
                <TableColumn text="Implemented Connection Type">
                    <cellValueFactory>
                        <PropertyValueFactory property="implementedConnectionType"/>
                    </cellValueFactory>
                </TableColumn>


                <TableColumn text="Connected To">
                    <cellValueFactory>
                        <PropertyValueFactory property="connectedTo"/>
                    </cellValueFactory>
                </TableColumn>
            </columns>
        </TableView>

        <GridPane fx:id="pane" vgap="10" hgap="10">

            <Text
                    text="Microservice Name:"
                    GridPane.rowIndex="0"
                    GridPane.columnIndex="0"
            />

            <TextField
                    fx:id="microserviceTxt"
                    GridPane.rowIndex="0"
                    GridPane.columnIndex="1"
            />

            <Text
                    text="URI:"
                    GridPane.rowIndex="1"
                    GridPane.columnIndex="0"
            />

            <TextField
                    fx:id="uriTxt"
                    GridPane.rowIndex="1"
                    GridPane.columnIndex="1"
            />

            <Text
                    text="Role:"
                    GridPane.rowIndex="2"
                    GridPane.columnIndex="0"
            />

            <TextField
                    fx:id="roleTxt"
                    GridPane.rowIndex="2"
                    GridPane.columnIndex="1"
            />

            <Text
                    text="Pattern Name:"
                    GridPane.rowIndex="3"
                    GridPane.columnIndex="0"
            />

            <TextField
                    fx:id="patternNameTxt"
                    GridPane.rowIndex="3"
                    GridPane.columnIndex="1"
            />

            <Text
                    text="Implemented Connection Type:"
                    GridPane.rowIndex="4"
                    GridPane.columnIndex="0"
            />

            <ScrollPane prefHeight="50" GridPane.rowIndex="4" GridPane.columnIndex="1">

                <VBox fx:id="connectionTypeVBox">

                    <ChoiceBox
                            fx:id="connectionTypeCB"
                            onMouseClicked="#connectionTypeAdd">

                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="POST"/>
                                <String fx:value="PUT"/>
                                <String fx:value="DELETE"/>
                                <String fx:value="GET"/>
                            </FXCollections>
                        </items>

                    </ChoiceBox>

                </VBox>

            </ScrollPane>

            <Text
                    text="Connected To:"
                    GridPane.rowIndex="5"
                    GridPane.columnIndex="0"
            />

            <ScrollPane prefHeight="50"
                        GridPane.rowIndex="5"
                        GridPane.columnIndex="1"
            >
                <HBox>
                    <VBox fx:id="textfieldVBox">
                        <TextField fx:id="textField" onKeyReleased="#connectedToAdd"/>
                    </VBox>
                    <VBox fx:id="choiceBoxVBox">
                        <ChoiceBox>
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="POST"/>
                                    <String fx:value="PUT"/>
                                    <String fx:value="DELETE"/>
                                    <String fx:value="GET"/>
                                </FXCollections>
                            </items>
                            <value>
                                <String fx:value="POST"/>
                            </value>
                        </ChoiceBox>
                    </VBox>
                </HBox>
            </ScrollPane>

            <Button
                    fx:id="saveToBtn"
                    text="Click to Set Target Directory for Contents Generated"
                    GridPane.rowIndex="0"
                    GridPane.columnIndex="3"
                    onAction="#saveToBtnLogic"
            />

            <Text
                    fx:id="pathTxt"
                    GridPane.rowIndex="0"
                    GridPane.columnIndex="4"
                    text="Your Project will be Saved on: "
            />

            <Button
                    fx:id="submitBtn"
                    alignment="CENTER"
                    text="Click to Insert Entries to Table"
                    GridPane.rowIndex="5"
                    GridPane.columnIndex="3"
                    onAction="#submitBtn"
            />

            <Button
                    fx:id="doneBtn"
                    text="Generate"
                    GridPane.rowIndex="1"
                    GridPane.columnIndex="3"
                    onAction="#doneBtnLogic"
            />

            <Text fx:id="errorTxt"
                  GridPane.columnIndex="2"
                  GridPane.rowIndex="4"
            />

        </GridPane>

    </VBox>

</ScrollPane>
